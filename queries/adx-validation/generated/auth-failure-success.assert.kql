// GENERATED from the captured 2026-10-15 synthetic ADX execution.
// Read-only in-memory datatable; NO Sentinel/Defender tenant execution.
// Never treat this replay as proof of real sensor or connector coverage.
let LabSyntheticAnchor = bin(now() - 2h, 15m);
let SigninLogs = datatable(FixtureMinute:int, Id:string, UserPrincipalName:string, IPAddress:string, ResultType:string, IsInteractive:bool)
[
    14, "a-f1", "alice@lab.local", "192.0.2.10", "50126", true,
    15, "a-f2", "alice@lab.local", "192.0.2.10", "50126", true,
    16, "a-f3", "alice@lab.local", "192.0.2.10", "50126", true,
    17, "a-f4", "alice@lab.local", "192.0.2.10", "50126", true,
    18, "a-f5", "alice@lab.local", "192.0.2.10", "50126", true,
    14, "a-f1", "alice@lab.local", "192.0.2.10", "50126", true,
    22, "a-ok", "alice@lab.local", "192.0.2.10", "0", true,
    14, "b-ok", "bob@lab.local", "192.0.2.11", "0", true,
    15, "b-f1", "bob@lab.local", "192.0.2.11", "50126", true,
    16, "b-f2", "bob@lab.local", "192.0.2.11", "50126", true,
    17, "b-f3", "bob@lab.local", "192.0.2.11", "50126", true,
    18, "b-f4", "bob@lab.local", "192.0.2.11", "50126", true,
    19, "b-f5", "bob@lab.local", "192.0.2.11", "50126", true
]
| extend TimeGenerated = LabSyntheticAnchor + FixtureMinute * 1m
| project-away FixtureMinute;
// SENTINEL / SigninLogs: strictly earlier interactive invalid-password failures
// followed by a success for the same user and source IP. Read-only candidate.
// NOT equivalent to the offline Python reset-state detector.
let Logins =
    SigninLogs
    | where TimeGenerated >= ago(2d)
    | where IsInteractive == true
    | where isnotempty(Id) and isnotempty(UserPrincipalName) and isnotempty(IPAddress)
    | extend UserKey = tolower(UserPrincipalName), Outcome = tostring(ResultType)
    | where Outcome in ("50126", "0")
    | project Id, EventTime = TimeGenerated, UserKey, IPAddress, Outcome
    | summarize arg_max(EventTime, *) by Id;
let Failed =
    Logins
    | where Outcome == "50126"
    | project UserKey, IPAddress, FailureTime = EventTime, FailureId = Id;
let Successful =
    Logins
    | where Outcome == "0" and EventTime >= ago(1d)
    | project UserKey, IPAddress, SuccessTime = EventTime, SuccessId = Id;
let LabSyntheticResults = materialize(
Successful
| join kind=inner (Failed) on UserKey, IPAddress
| where FailureTime < SuccessTime and FailureTime >= SuccessTime - 15m
| summarize FailureCount = count(), FirstFailure = min(FailureTime),
    LastFailure = max(FailureTime), FailureIds = make_set(FailureId, 32)
    by UserKey, IPAddress, SuccessTime, SuccessId
| where FailureCount >= 5
| project SuccessTime, UserKey, IPAddress, FailureCount, FirstFailure,
    LastFailure, SuccessId, FailureIds
| order by SuccessTime desc
);
let LabObserved = toscalar(LabSyntheticResults | count);
let LabMatched = toscalar(LabSyntheticResults | where UserKey == "alice@lab.local" and IPAddress == "192.0.2.10" and FailureCount == 5 and SuccessId == "a-ok" | count);
let LabActualIds = toscalar(LabSyntheticResults | summarize Ids=make_set(SuccessId));
let LabExpectedIds = dynamic(["a-ok"]);
let LabIdsEqual = array_length(set_difference(LabActualIds, LabExpectedIds)) == 0
  and array_length(set_difference(LabExpectedIds, LabActualIds)) == 0;
print Scenario="auth-failure-success", Expected=1, Observed=LabObserved, Matched=LabMatched,
  IdentityMatch=LabIdsEqual,
  Verdict=iff(LabObserved == 1 and LabMatched == 1 and LabIdsEqual, "PASS", "FAIL")
