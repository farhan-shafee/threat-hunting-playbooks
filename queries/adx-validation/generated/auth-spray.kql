// GENERATED from the captured 2026-10-15 synthetic ADX execution.
// Read-only in-memory datatable; NO Sentinel/Defender tenant execution.
// Never treat this replay as proof of real sensor or connector coverage.
let __SyntheticAnchor = bin(now() - 2h, 15m);
let SigninLogs = datatable(FixtureMinute:int, Id:string, UserPrincipalName:string, IPAddress:string, ResultType:string, IsInteractive:bool)
[
    1, "sp-0", "a@lab.local", "192.0.2.80", "50126", true,
    2, "sp-1", "b@lab.local", "192.0.2.80", "50126", true,
    3, "sp-2", "c@lab.local", "192.0.2.80", "50126", true,
    4, "sp-3", "a@lab.local", "192.0.2.80", "50126", true,
    5, "sp-4", "b@lab.local", "192.0.2.80", "50126", true,
    6, "sp-5", "c@lab.local", "192.0.2.80", "50126", true,
    1, "sp-0", "a@lab.local", "192.0.2.80", "50126", true,
    1, "other-0", "a@lab.local", "192.0.2.81", "50126", true,
    2, "other-1", "a@lab.local", "192.0.2.81", "50126", true,
    3, "other-2", "a@lab.local", "192.0.2.81", "50126", true,
    4, "other-3", "a@lab.local", "192.0.2.81", "50126", true,
    5, "other-4", "a@lab.local", "192.0.2.81", "50126", true
]
| extend TimeGenerated = __SyntheticAnchor + FixtureMinute * 1m
| project-away FixtureMinute;
// SENTINEL / SigninLogs: fixed 15-minute BIN password-spray candidate.
// Bin boundary misses are possible; this is NOT a sliding 15-minute window.
// Only ResultType=50126 is counted; service-principal sign-ins are excluded.
SigninLogs
| where TimeGenerated >= ago(1d)
| where IsInteractive == true
| where tostring(ResultType) == "50126"
| where isnotempty(Id) and isnotempty(UserPrincipalName) and isnotempty(IPAddress)
| project EventTime = TimeGenerated, SigninId = Id,
    UserKey = tolower(UserPrincipalName), IPAddress
| summarize arg_max(EventTime, *) by SigninId
| summarize FailureEvents = count(), DistinctUsers = count_distinct(UserKey),
    FirstSeen = min(EventTime), LastSeen = max(EventTime),
    SampleIds = make_set(SigninId, 32)
    by IPAddress, WindowStart = bin(EventTime, 15m)
| where FailureEvents >= 6 and DistinctUsers >= 3
| project WindowStart, IPAddress, FailureEvents, DistinctUsers,
    FirstSeen, LastSeen, SampleIds
| order by WindowStart desc
