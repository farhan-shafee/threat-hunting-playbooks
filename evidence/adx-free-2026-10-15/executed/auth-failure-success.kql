// Synthetic ADX validation - zero persistent tables, no secret telemetry.
// Expected: 1 Alice candidate with FailureCount=5; Bob success-before-failures excluded.
let SigninLogs = datatable(TimeGenerated:datetime, Id:string, UserPrincipalName:string, IPAddress:string, ResultType:string, IsInteractive:bool)
[
    datetime(2026-10-15T04:14:00Z), "a-f1", "alice@lab.local", "192.0.2.10", "50126", true,
    datetime(2026-10-15T04:15:00Z), "a-f2", "alice@lab.local", "192.0.2.10", "50126", true,
    datetime(2026-10-15T04:16:00Z), "a-f3", "alice@lab.local", "192.0.2.10", "50126", true,
    datetime(2026-10-15T04:17:00Z), "a-f4", "alice@lab.local", "192.0.2.10", "50126", true,
    datetime(2026-10-15T04:18:00Z), "a-f5", "alice@lab.local", "192.0.2.10", "50126", true,
    datetime(2026-10-15T04:14:00Z), "a-f1", "alice@lab.local", "192.0.2.10", "50126", true,
    datetime(2026-10-15T04:22:00Z), "a-ok", "alice@lab.local", "192.0.2.10", "0", true,
    datetime(2026-10-15T04:14:00Z), "b-ok", "bob@lab.local", "192.0.2.11", "0", true,
    datetime(2026-10-15T04:15:00Z), "b-f1", "bob@lab.local", "192.0.2.11", "50126", true,
    datetime(2026-10-15T04:16:00Z), "b-f2", "bob@lab.local", "192.0.2.11", "50126", true,
    datetime(2026-10-15T04:17:00Z), "b-f3", "bob@lab.local", "192.0.2.11", "50126", true,
    datetime(2026-10-15T04:18:00Z), "b-f4", "bob@lab.local", "192.0.2.11", "50126", true,
    datetime(2026-10-15T04:19:00Z), "b-f5", "bob@lab.local", "192.0.2.11", "50126", true
];
// SENTINEL / SigninLogs: strictly earlier interactive invalid-password failures
// followed by a success for the same user and source IP. Read-only candidate.
// NOT equivalent to the offline Python reset-state detector.
let Logins =
    SigninLogs
    | where TimeGenerated >= ago(2d)
    | where IsInteractive == true
    | where isnotempty(Id) and isnotempty(UserPrincipalName) and isnotempty(IPAddress)
    | extend UserKey = tolower(UserPrincipalName), Outcome = tostring(ResultType)
    | where Outcome in ("50126", "0")
    | project Id, EventTime = TimeGenerated, UserKey, IPAddress, Outcome
    | summarize arg_max(EventTime, *) by Id;
let Failed =
    Logins
    | where Outcome == "50126"
    | project UserKey, IPAddress, FailureTime = EventTime, FailureId = Id;
let Successful =
    Logins
    | where Outcome == "0" and EventTime >= ago(1d)
    | project UserKey, IPAddress, SuccessTime = EventTime, SuccessId = Id;
Successful
| join kind=inner (Failed) on UserKey, IPAddress
| where FailureTime < SuccessTime and FailureTime >= SuccessTime - 15m
| summarize FailureCount = count(), FirstFailure = min(FailureTime),
    LastFailure = max(FailureTime), FailureIds = make_set(FailureId, 32)
    by UserKey, IPAddress, SuccessTime, SuccessId
| where FailureCount >= 5
| project SuccessTime, UserKey, IPAddress, FailureCount, FirstFailure,
    LastFailure, SuccessId, FailureIds
| order by SuccessTime desc
