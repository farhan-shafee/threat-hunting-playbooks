// Synthetic in-memory ADX validation; no saved tables.
let DeviceRegistryEvents = datatable(Timestamp:datetime, DeviceName:string, ActionType:string, RegistryKey:string, RegistryValueName:string, RegistryValueData:string, InitiatingProcessFileName:string, InitiatingProcessAccountName:string, ReportId:long)
[
    datetime(2026-10-15T04:44:00Z), "LAB-PC", "RegistryValueSet", "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\Updater", "Updater", "C:\\Users\\lab\\agent.exe", "explorer.exe", "lab", 301,
    datetime(2026-10-15T04:47:00Z), "LAB-PC", "RegistryValueSet", "HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\Tasks", "Task", "C:\\Windows\\system32\\agent.exe", "services.exe", "system", 302,
    datetime(2026-10-15T04:50:00Z), "LAB-PC", "RegistryValueSet", "HKEY_CURRENT_USER\\Software\\Legit\\Config", "Enabled", "1", "explorer.exe", "lab", 303
];
// DEFENDER XDR / DeviceRegistryEvents: Windows autorun registry changes.
// RegistryValueData is deliberately NOT filtered by script keywords;
// direct unfamiliar executable paths must remain reviewable.
// Does NOT detect all task or service creation; requires DeviceEvents/Windows logs.
DeviceRegistryEvents
| where Timestamp >= ago(1d)
| where isnotempty(RegistryKey)
| where RegistryKey contains @"\CurrentVersion\Run"
    or RegistryKey contains @"\CurrentVersion\RunOnce"
    or RegistryKey contains @"\Schedule\TaskCache"
| project Timestamp, DeviceName, ActionType, RegistryKey,
    RegistryValueName, RegistryValueData,
    InitiatingProcessFileName, InitiatingProcessAccountName, ReportId
| order by Timestamp desc
